# Neon PostgreSQL connection string
# Get this from your Neon dashboard → Connection Details
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Comma-separated list of allowed frontend origins
# For local dev: http://localhost:5173
# For production: your Vercel URL e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# The backend URL the frontend talks to
# For local dev: http://localhost:8000
# For production: your Render URL e.g. https://your-api.onrender.com
VITE_API_URL=http://localhost:8000
